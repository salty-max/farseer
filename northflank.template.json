{
  "apiVersion": "v1.2",
  "name": "farseer",
  "description": "Farseer monolith (Bun/Hono: SPA + API + in-process poller); Postgres is external (Supabase free tier)",
  "options": {
    "autorun": false,
    "concurrencyPolicy": "allow",
    "runOnUpdate": false
  },
  "arguments": {
    "DATABASE_URL": "",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_PRIVATE_KEY": "",
    "VAPID_SUBJECT": "https://github.com/salty-max/farseer",
    "CRON_SECRET": "",
    "LOG_FORMAT": "json"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "Farseer",
            "region": "europe-west",
            "networking": {
              "allowedIngressProjects": []
            }
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "CombinedService",
                "ref": "app",
                "spec": {
                  "name": "farseer",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/salty-max/farseer",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "kaniko",
                      "useCache": true,
                      "dockerWorkDir": "/",
                      "dockerFilePath": "/Dockerfile"
                    }
                  },
                  "disabledCI": false,
                  "deployment": {
                    "instances": 1
                  },
                  "ports": [
                    {
                      "name": "p01",
                      "internalPort": 3000,
                      "protocol": "HTTP",
                      "public": true,
                      "domains": [],
                      "disableNfDomain": false
                    }
                  ],
                  "runtimeEnvironment": {
                    "VAPID_PUBLIC_KEY": "${args.VAPID_PUBLIC_KEY}",
                    "VAPID_SUBJECT": "${args.VAPID_SUBJECT}",
                    "LOG_FORMAT": "${args.LOG_FORMAT}"
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "secrets",
                "spec": {
                  "name": "farseer-secrets",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "DATABASE_URL": "${args.DATABASE_URL}",
                      "VAPID_PRIVATE_KEY": "${args.VAPID_PRIVATE_KEY}",
                      "CRON_SECRET": "${args.CRON_SECRET}"
                    }
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}

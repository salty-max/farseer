{
  "name": "@farseer/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:backfill": "bun run src/db/backfill.ts",
    "vapid": "bun run src/db/vapid.ts",
    "db:sim": "bun run src/db/sim-push.ts"
  },
  "dependencies": {
    "@farseer/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}

# Local Postgres from `bun run db` (this is also the default when unset).
DATABASE_URL=postgres://farseer:farseer@localhost:5433/farseer

# Web Push (VAPID). Generate with `bun run --filter @farseer/api vapid`.
# Push is a silent no-op until all three are set. NEVER commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guards POST /api/admin/*. Unset = admin routes disabled.
CRON_SECRET=

# Optional: SCHEDULER=off disables the in-process poller; LOG_FORMAT=json|pretty.
